<Project Sdk="Microsoft.NET.Sdk.Worker">

  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <RootNamespace>ParentalGuard.Service</RootNamespace>
    <OutputType>Exe</OutputType>
    <!-- A Windows Service identity; also handy to run from console during dev. -->
    <UserSecretsId>parentalguard-service</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="10.0.0" />
    <PackageReference Include="Microsoft.Extensions.Hosting.WindowsServices" Version="10.0.0" />
    <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.0" />
    <!--
      Pin the native SQLite library to a patched build. Microsoft.Data.Sqlite 10.0.0 pulls in
      SQLitePCLRaw.lib.e_sqlite3 2.1.11 transitively, which carries CVE-2025-6965
      (GHSA-2m69-gcr7-jv3q). A direct reference to the 2.1.12 bundle wins over the transitive
      2.1.11 and ships SQLite >= 3.50.2, clearing the NU1903 warning.
    -->
    <PackageReference Include="SQLitePCLRaw.bundle_e_sqlite3" Version="2.1.12" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\ParentalGuard.Core\ParentalGuard.Core.csproj" />
  </ItemGroup>

</Project>
